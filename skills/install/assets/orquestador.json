{
  "language": "{{LANGUAGE: ISO code, e.g. en}}",
  "storiesDir": "{{STORIES_DIR: e.g. product}}",
  "verify": {
    "all": ["{{FULL_VERIFICATION_COMMANDS: lint, typecheck, test, build}}"],
    "onBuilderStop": ["{{FAST_COMMANDS: run when a builder stops, e.g. typecheck and tests}}"]
  },
  "runnerLimit": "{{ONE_SENTENCE: what the tests cannot prove}}",
  "seams": [
    { "a": "{{PATH_A}}", "b": "{{PATH_B}}", "watcher": "{{TEST | DERIVED | PERSON}}" }
  ],
  "riskTags": ["production", "legal", "security", "costs"],
  "copy": { "master": "{{COPY_MASTER_DOC}}", "rules": "{{VOICE_RULES_FILE_OR_SKILL}}" },
  "design": "{{DESIGN_SOURCE: design file link, design-system docs}}",
  "git": {
    "protectedBranches": ["main", "master"],
    "allowPush": false,
    "blockBroadAdd": true,
    "codeOwner": "{{CODE_OWNER or null}}"
  }
}
